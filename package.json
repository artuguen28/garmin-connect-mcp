{
  "name": "garmin-connect-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for Garmin Connect activities",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json",
    "tunnel": "lt --port 3000",
    "tunnel:cloudflare": "cloudflared tunnel --url http://localhost:3000",
    "dev:cloudflare": "./scripts/dev-cloudflare.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artuguen28/garmin-connect-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/artuguen28/garmin-connect-mcp/issues"
  },
  "homepage": "https://github.com/artuguen28/garmin-connect-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "garmin-connect": "^1.6.2",
    "localtunnel": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
